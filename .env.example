# Required: NVIDIA API key from https://build.nvidia.com/settings
# Supports a single key or comma-separated keys for automatic failover.
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Server port (defaults to 3000)
PORT=3000

# Optional: Serverless host timeout in seconds (defaults to 300, matching vercel.json)
# FUNCTION_MAX_DURATION_SECONDS=300

# Optional: External activity log relay (silently disabled when omitted)
# LOG_API_URL=https://script.google.com/macros/s/your-deployment-id/exec
# LOG_API_SECRET=your-long-random-secret
